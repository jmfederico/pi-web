# Keep the local-build runtime context small and avoid sending persistent data.
*
!Dockerfile
!pi-web-docker
!internal/
!internal/bin/
!internal/bin/hostexec
!internal/bin/pi-web-service
!internal/bin/pi-web-image-doctor
!internal/bin/pi-web-reconcile-mise
!internal/image/
!internal/image/*
!custom-image.d/
!custom-image.d/.gitkeep
!custom-image.d/*.sh
