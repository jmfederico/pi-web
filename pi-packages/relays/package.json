  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": ["./extensions/index.js"],
    "skills": ["./skills"],
    "prompts": ["./prompts"]
  },
  "piWeb": {
    "plugins": [
      { "id": "relays", "browserRoot": ".", "module": "pi-web-plugin.js" }
    ]
  }
}
